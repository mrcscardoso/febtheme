{{!< default}}
{{!-- Home (DESIGN.md §6.2): destaque, barra de filtros, seções por tag e newsletter --}}

<main id="gh-main" class="gh-main feb-home">

    {{#get "posts" filter="featured:true" include="tags" limit="1" as |destaque|}}
        {{#if destaque}}
            {{#foreach destaque}}
                {{> "components/hero"}}
                {{> "components/home-sections"}}
            {{/foreach}}
        {{else}}
            {{!-- Sem post em destaque: usa o mais recente --}}
            {{#get "posts" include="tags" limit="1" as |recente|}}
                {{#foreach recente}}
                    {{> "components/hero"}}
                    {{> "components/home-sections"}}
                {{/foreach}}
            {{/get}}
        {{/if}}
    {{/get}}

    {{> "components/cta" email_field_id="newsletter-email-home"}}

</main>
