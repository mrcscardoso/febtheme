{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{#post}}

<main class="gh-main">

    <article class="gh-article {{post_class}}">

        <header class="gh-article-header gh-canvas">

            {{#if primary_tag}}
                <a class="gh-article-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
            {{/if}}
            <h1 class="gh-article-title is-title">{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="gh-article-excerpt is-body">{{custom_excerpt}}</p>
            {{/if}}

            {{#if @custom.show_post_metadata}}
                <div class="gh-meta-share">
                    <p class="feb-meta feb-post-meta">
                        <span class="gh-article-author-name">{{authors}}</span>
                        <span class="feb-sep" aria-hidden="true">·</span>
                        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM, YYYY"}}</time>
                        {{#if reading_time}}
                            <span class="feb-sep" aria-hidden="true">·</span>
                            <span>{{reading_time minute=(t "1 min de leitura") minutes=(t "% min de leitura")}}</span>
                        {{/if}}
                    </p>
                    <a href="#/share" class="gh-button-share">
                        {{t "Share"}}
                    </a>
                </div>
            {{/if}}

            {{> "feature-image"}}

        </header>

        <section class="gh-content gh-canvas is-body{{#if @custom.enable_drop_caps_on_posts}} drop-cap{{/if}}">
            {{content}}
        </section>

    </article>

    {{#if comments}}
        <div class="gh-comments gh-canvas">
            {{comments}}
        </div>
    {{/if}}

</main>

{{/post}}

{{> "components/cta" email_field_id="newsletter-email-post"}}

{{#if @custom.show_related_articles}}
    {{#get "posts" include="tags" filter="id:-{{post.id}}" limit="3" as |next|}}
        {{#if next}}
            <section class="gh-container is-grid gh-outer" data-nosnippet>
                <div class="gh-container-inner gh-inner">
                    <header class="feb-section-head">
                        <h2 class="feb-section-title">{{t "Leia também"}}</h2>
                        <span class="feb-section-rule" aria-hidden="true"></span>
                    </header>
                    <div class="gh-feed feb-grid">
                        {{#foreach next}}
                            {{> "post-card" lazyLoad=true}}
                        {{/foreach}}
                    </div>
                </div>
            </section>
        {{/if}}
    {{/get}}
{{/if}}
