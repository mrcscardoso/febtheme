{
    "name": "febtheme",
    "description": "Tema oficial do Farmaco em Bolus",
    "demo": "https://source.ghost.io",
    "version": "1.0.0",
    "engines": {
        "ghost": ">=5.0.0",
        "node": ">=22.12.0"
    },
    "license": "MIT",
    "scripts": {
        "dev": "gulp",
        "zip": "gulp zip",
        "build": "gulp build",
        "test": "gscan .",
        "test:ci": "gscan --fatal --verbose .",
        "pretest": "pnpm zip",
        "pretest:ci": "pnpm zip",
        "preship": "pnpm test",
        "ship": "STATUS=$(git status --porcelain); echo $STATUS; if [ -z \"$STATUS\" ]; then git push --follow-tags; else echo \"Uncommitted changes found.\" && exit 1; fi",
        "postship": "git fetch && gulp release"
    },
    "packageManager": "pnpm@12.20.0",
    "author": {
        "name": "Ghost Foundation",
        "email": "hello@ghost.org",
        "url": "https://ghost.org/"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/TryGhost/Source.git"
    },
    "bugs": "https://github.com/TryGhost/Source/issues",
    "contributors": "https://github.com/TryGhost/Source/graphs/contributors",
    "devDependencies": {
        "@tryghost/release-utils": "0.10.1",
        "@tryghost/theme-translations": "0.0.22",
        "autoprefixer": "10.6.2",
        "beeper": "2.1.0",
        "cssnano": "9.9.0",
        "gscan": "6.7.0",
        "gulp": "5.0.1",
        "gulp-concat": "2.6.1",
        "gulp-livereload": "4.0.2",
        "gulp-postcss": "10.0.0",
        "gulp-uglify": "3.0.2",
        "gulp-zip": "6.1.0",
        "inquirer": "14.3.0",
        "postcss": "8.5.33",
        "postcss-easy-import": "4.0.0",
        "pump": "3.0.4"
    },
    "browserslist": [
        "defaults"
    ],
    "config": {
        "posts_per_page": 12,
        "image_sizes": {
            "xs": {
                "width": 160
            },
            "s": {
                "width": 320
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 960
            },
            "xl": {
                "width": 1200
            },
            "xxl": {
                "width": 2000
            }
        },
        "card_assets": true,
        "custom": {
            "site_background_color": {
                "type": "color",
                "default": "#F9F9F9"
            },
            "signup_heading": {
                "type": "text",
                "description": "Título do bloco de newsletter",
                "default": "Boas ideias merecem um lugar na sua caixa."
            },
            "section_1_tag": {
                "type": "text",
                "group": "homepage",
                "description": "Slug da tag da 1ª seção da home (ex.: design). Vazio = mostra os posts mais recentes"
            },
            "section_1_title": {
                "type": "text",
                "group": "homepage",
                "description": "Título da 1ª seção (ex.: Design & criatividade). Vazio = nome da tag"
            },
            "section_2_tag": {
                "type": "text",
                "group": "homepage",
                "description": "Slug da tag da 2ª seção da home (ex.: tecnologia)"
            },
            "section_2_title": {
                "type": "text",
                "group": "homepage",
                "description": "Título da 2ª seção (ex.: Tecnologia & futuro). Vazio = nome da tag"
            },
            "show_publish_date": {
                "type": "boolean",
                "default": true,
                "group": "homepage"
            },
            "show_publication_info_sidebar": {
                "type": "boolean",
                "default": false,
                "group": "homepage"
            },
            "show_post_metadata": {
                "type": "boolean",
                "default": true,
                "group": "post"
            },
            "enable_drop_caps_on_posts": {
                "type": "boolean",
                "default": false,
                "group": "post"
            },
            "show_related_articles": {
                "type": "boolean",
                "default": true,
                "group": "post"
            }
        }
    }
}
