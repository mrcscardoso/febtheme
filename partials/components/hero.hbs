{{!-- Destaque da home (DESIGN.md §6.2.1). Contexto: um post. --}}
<section class="feb-hero gh-outer">
    <div class="feb-hero-inner gh-inner">
        <div class="feb-hero-text">
            <p class="feb-hero-label">
                <span>{{#if featured}}{{t "Em destaque"}}{{else}}{{t "Mais recente"}}{{/if}}</span>
                {{#if primary_tag}}<span aria-hidden="true">/</span> <a href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
            </p>
            <h1 class="feb-hero-title is-title"><a href="{{url}}">{{title}}</a></h1>
            <p class="feb-meta feb-hero-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM, YYYY"}}</time>
                {{#if reading_time}}
                    <span class="feb-sep" aria-hidden="true">·</span>
                    <span>{{reading_time minute=(t "1 min de leitura") minutes=(t "% min de leitura")}}</span>
                {{/if}}
            </p>
        </div>
        {{#if feature_image}}
            <a class="feb-hero-media" href="{{url}}" tabindex="-1" aria-hidden="true">
                <img
                    loading="eager"
                    fetchpriority="high"
                    srcset="{{img_url feature_image size="m" format="webp"}} 600w,
                            {{img_url feature_image size="l" format="webp"}} 960w,
                            {{img_url feature_image size="xl" format="webp"}} 1200w,
                            {{img_url feature_image size="xxl" format="webp"}} 2000w"
                    sizes="(max-width: 991px) 100vw, 686px"
                    src="{{img_url feature_image size="xl"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                >
            </a>
        {{/if}}
    </div>
</section>
