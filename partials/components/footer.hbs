{{!-- Rodapé (DESIGN.md §6.3). Mantém a classe gh-footer, usada pela rolagem infinita (assets/js/pagination.js). --}}
<footer class="gh-footer feb-footer gh-outer">
    <div class="feb-footer-inner gh-inner">

        <div class="feb-footer-top">
            <a class="feb-footer-logo" href="{{@site.url}}">
                {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}">
                {{else}}
                    {{@site.title}}
                {{/if}}
            </a>

            <div class="feb-footer-cols">
                <nav class="feb-footer-col" aria-label="{{t "Explore"}}">
                    <h2 class="feb-footer-heading">{{t "Explore"}}</h2>
                    {{navigation}}
                </nav>
                <nav class="feb-footer-col" aria-label="{{t "Rodapé"}}">
                    <h2 class="feb-footer-heading">{{@site.title}}</h2>
                    {{navigation type="secondary"}}
                </nav>
            </div>
        </div>

        <div class="feb-footer-bottom">
            <p>&copy; {{date format="YYYY"}} {{@site.title}}. {{t "Todos os direitos reservados."}}</p>
            {{#get "pages" filter="slug:[privacidade,politica-de-privacidade,termos-de-uso]" limit="3" as |legais|}}
                {{#if legais}}
                    <ul class="feb-footer-legal">
                        {{#foreach legais}}
                            <li><a href="{{url}}">{{title}}</a></li>
                        {{/foreach}}
                    </ul>
                {{/if}}
            {{/get}}
        </div>

    </div>
</footer>
