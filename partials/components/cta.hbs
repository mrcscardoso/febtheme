{{!-- Newsletter (DESIGN.md §6.2.4): card em azul claro. Parâmetro: email_field_id. Oculta para membros logados. --}}
{{#if @site.members_enabled}}
    {{#unless @member}}
        <section class="gh-cta feb-newsletter gh-outer">
            <div class="gh-inner">
                <div class="feb-newsletter-card">
                    <div class="feb-newsletter-head">
                        <span class="feb-newsletter-icon" aria-hidden="true">{{> "icons/mail"}}</span>
                        <h2 class="feb-newsletter-title is-title">
                            {{#if @custom.signup_heading}}{{@custom.signup_heading}}{{else}}{{@site.title}}{{/if}}
                        </h2>
                    </div>
                    {{!-- Texto-padrão do Ghost para convite à inscrição (chave oficial de @tryghost/theme-translations;
                         tradução pt-BR em locales-local/pt-BR.json) --}}
                    <p class="feb-newsletter-text">{{t "Don’t miss out on the latest issues. Sign up now to get access to the library of members-only issues."}}</p>
                    <div class="feb-newsletter-form">
                        {{> "email-subscription" email_field_id=email_field_id}}
                    </div>
                </div>
            </div>
        </section>
    {{/unless}}
{{/if}}
