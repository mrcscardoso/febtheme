{{!-- Cabeçalho (DESIGN.md §6.1).
     Desktop: logo | busca, Entrar, Inscrever-se. Celular (≤ 767px): logo | busca, menu.
     O menu usa o botão .gh-burger padrão do tema; abrir/fechar e travar a rolagem ficam
     com o script do Source (assets/js/main.js), que procura #gh-navigation / .gh-navigation.
     O painel não usa a classe .gh-navigation-menu, para o dropdown.js do Source não agir sobre ele. --}}
<header id="gh-navigation" class="gh-navigation feb-header gh-outer">
    <div class="feb-header-inner gh-inner">

        <a class="feb-logo{{#unless @site.logo}} is-text{{/unless}}" href="{{@site.url}}">
            {{#if @site.logo}}
                <img src="{{@site.logo}}" alt="{{@site.title}}">
            {{else}}
                {{@site.title}}
            {{/if}}
        </a>

        <div class="feb-header-actions">
            <button class="feb-icon-button" type="button" aria-label="{{t "Buscar"}}" data-ghost-search>
                {{> "icons/search"}}
            </button>
            {{#if @site.members_enabled}}
                <div class="feb-header-members">
                    {{#unless @member}}
                        <a class="feb-signin" href="#/portal/signin" data-portal="signin">{{t "Entrar"}}</a>
                        {{#unless @site.members_invite_only}}
                            <a class="gh-button" href="#/portal/signup" data-portal="signup">{{t "Inscrever-se"}}</a>
                        {{/unless}}
                    {{else}}
                        <a class="feb-signin" href="#/portal/account" data-portal="account">{{t "Minha conta"}}</a>
                    {{/unless}}
                </div>
            {{/if}}
            <button class="gh-burger feb-icon-button" type="button" aria-label="{{t "Menu"}}" aria-expanded="false" aria-controls="feb-mobile-menu">
                {{> "icons/burger"}}
                {{> "icons/close"}}
            </button>
        </div>

        {{!-- Painel do menu no celular: páginas (navegação principal) e acesso de membros --}}
        <div class="feb-mobile-menu" id="feb-mobile-menu">
            <nav aria-label="{{t "Principal"}}">
                {{navigation}}
            </nav>
            {{#if @site.members_enabled}}
                <div class="feb-mobile-members">
                    {{#unless @member}}
                        {{#unless @site.members_invite_only}}
                            <a class="gh-button" href="#/portal/signup" data-portal="signup">{{t "Inscrever-se"}}</a>
                        {{/unless}}
                        <a class="feb-signin" href="#/portal/signin" data-portal="signin">{{t "Entrar"}}</a>
                    {{else}}
                        <a class="feb-signin" href="#/portal/account" data-portal="account">{{t "Minha conta"}}</a>
                    {{/unless}}
                </div>
            {{/if}}
        </div>

    </div>
</header>
