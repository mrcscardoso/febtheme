{{!-- Card de post (DESIGN.md §5): imagem 16:10 → tag → título → meta. O card inteiro é clicável. --}}
<article class="gh-card feb-card {{post_class}}">
    {{#if feature_image}}
        <figure class="feb-card-image">
            <img
                srcset="{{img_url feature_image size="s" format="webp"}} 320w,
                        {{img_url feature_image size="m" format="webp"}} 600w,
                        {{img_url feature_image size="l" format="webp"}} 960w"
                sizes="(max-width: 575px) 100vw, (max-width: 991px) 50vw, 413px"
                src="{{img_url feature_image size="m"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                loading="lazy"
            >
        </figure>
    {{/if}}
    {{#if primary_tag}}
        <p class="feb-card-tag">{{primary_tag.name}}</p>
    {{/if}}
    <h3 class="feb-card-title is-title"><a class="gh-card-title-link" href="{{url}}">{{title}}</a></h3>
    <p class="feb-meta">
        {{#unless access}}
            {{^has visibility="public"}}
                <span class="feb-badge" title="{{t "Conteúdo para assinantes"}}">{{> "icons/padlock"}}{{t "Para assinantes"}}</span>
            {{/has}}
        {{/unless}}
        {{#if @custom.show_publish_date}}
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM, YYYY"}}</time>
            {{#if reading_time}}<span class="feb-sep" aria-hidden="true">·</span>{{/if}}
        {{/if}}
        {{#if reading_time}}
            <span>{{reading_time minute=(t "1 min") minutes=(t "% min")}}</span>
        {{/if}}
    </p>
</article>
